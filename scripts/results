#!/usr/bin/env python3
"""analyze: summarize VASP runs in every subfolder of the current folder,
then open all final structures in ase gui (one frame per folder).

Usage: analyze           table + ase gui
       analyze -n        table only (no gui)
       analyze -s        sort table by energy
"""
import os
import subprocess
import sys

from ase.io import read, write

no_gui = "-n" in sys.argv
sort_e = "-s" in sys.argv

# folders with a queued/running job
try:
    q = subprocess.run(["squeue", "-u", os.environ["USER"], "-h", "-o", "%Z"],
                       capture_output=True, text=True).stdout.split()
    active = {os.path.realpath(p) for p in q}
except Exception:
    active = set()

rows, images, labels = [], [], []
for d in sorted(x for x in os.listdir(".") if os.path.isdir(x) and not x.startswith(".")):
    outcar = os.path.join(d, "OUTCAR")
    running = os.path.realpath(d) in active
    if not os.path.isfile(outcar):
        if running or os.path.isfile(os.path.join(d, "INCAR")):
            rows.append((d, None, None, None, "running" if running else "not run"))
        continue

    text = open(outcar, errors="ignore").read()
    converged = "reached required accuracy" in text
    try:
        traj = read(outcar, index=":")
        atoms = traj[-1]
        e = atoms.get_potential_energy()
        fmax = (atoms.get_forces() ** 2).sum(axis=1).max() ** 0.5  # fixed atoms excluded
        steps = len(traj)
    except Exception:
        # OUTCAR unreadable (e.g. killed mid-write): fall back to CONTCAR for the picture
        e = fmax = steps = None
        try:
            atoms = read(os.path.join(d, "CONTCAR"))
        except Exception:
            atoms = None

    status = "running" if running else ("done" if converged else "NOT CONVERGED")
    rows.append((d, e, fmax, steps, status))
    if atoms is not None:
        atoms.info["label"] = d
        images.append(atoms)
        labels.append(d)

if not rows:
    sys.exit("No calculation folders found here.")

if sort_e:
    rows.sort(key=lambda r: (r[1] is None, r[1] if r[1] is not None else 0))

energies = [r[1] for r in rows if r[1] is not None]
emin = min(energies) if energies else 0.0
w = max(len(r[0]) for r in rows) + 2

print(f"{'folder':<{w}}{'E (eV)':>14}{'dE (eV)':>10}{'fmax':>8}{'steps':>7}  status")
print("-" * (w + 50))
for d, e, fmax, steps, status in rows:
    es = f"{e:14.4f}" if e is not None else f"{'-':>14}"
    ds = f"{e - emin:10.3f}" if e is not None else f"{'-':>10}"
    fs = f"{fmax:8.3f}" if fmax is not None else f"{'-':>8}"
    ss = f"{steps:7d}" if steps is not None else f"{'-':>7}"
    print(f"{d:<{w}}{es}{ds}{fs}{ss}  {status}")

# save table for later
with open("energies.txt", "w") as f:
    f.write("folder,E_eV,dE_eV,fmax,steps,status\n")
    for d, e, fmax, steps, status in rows:
        f.write(f"{d},{'' if e is None else e},{'' if e is None else e - emin},"
                f"{'' if fmax is None else round(fmax, 4)},{'' if steps is None else steps},{status}\n")
print("\nSaved table to energies.txt")

if images and not no_gui:
    print("ase gui frames:")
    for i, l in enumerate(labels):
        print(f"  {i}: {l}")
    write("all_final.traj", images)
    subprocess.run(["ase", "gui", "all_final.traj"])
